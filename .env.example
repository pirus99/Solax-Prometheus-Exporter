# =============================================================================
# Solax Prometheus Exporter — Configuration
# Copy this file to .env and fill in your values.
# The .env file is listed in .gitignore and will NOT be committed.
# =============================================================================


# ---------------------------------------------------------------------------
# Inverter instances
# ---------------------------------------------------------------------------

# Total number of inverters to monitor (1–200).
INVERTER_COUNT=1

# --- Inverter 1 ---
# Label used in every Prometheus metric for this inverter.
# Use only letters, digits, and underscores — no spaces.
INVERTER_1_NAME=inverter_1

# Full HTTP URL of the inverter's local web API (no trailing slash).
INVERTER_1_ENDPOINT=http://192.168.1.100

# Inverter serial number.  This is also the password for the local API.
INVERTER_1_SERIAL=YOUR_SERIAL_NUMBER_HERE

# --- Inverter 2 (uncomment block + set INVERTER_COUNT=2 to enable) ---
# INVERTER_2_NAME=inverter_2
# INVERTER_2_ENDPOINT=http://192.168.1.101
# INVERTER_2_SERIAL=SECOND_SERIAL_NUMBER_HERE

# --- Inverter 3 (uncomment block + set INVERTER_COUNT=3 to enable) ---
# INVERTER_3_NAME=inverter_3
# INVERTER_3_ENDPOINT=http://192.168.1.102
# INVERTER_3_SERIAL=THIRD_SERIAL_NUMBER_HERE

# Add as many INVERTER_N_* blocks as you need (up to INVERTER_COUNT).


# ---------------------------------------------------------------------------
# Exporter settings
# ---------------------------------------------------------------------------

# TCP port where Prometheus scrapes metrics.
# Port 9101 is used by default to avoid conflicting with the Prometheus server
# itself (which defaults to 9090).  Change to any free port you prefer.
EXPORTER_PORT=9101

# How often the exporter polls each inverter (seconds).
SCRAPE_INTERVAL=30

# Per-request HTTP timeout when contacting an inverter (seconds).
REQUEST_TIMEOUT=10


# ---------------------------------------------------------------------------
# Smart meter (optional)
# ---------------------------------------------------------------------------
# Set to true only if a smart meter is physically connected to the inverter.
# When enabled, the following extra metrics are exported:
#   solax_feedin_power_watts      – power exported to (positive) / imported from (negative) grid
#   solax_load_power_watts        – instantaneous house consumption
#   solax_total_feed_energy_kwh   – lifetime energy exported to grid
#   solax_total_import_energy_kwh – lifetime energy imported from grid
#
# NOTE: The Data[] array indices used for smart-meter readings may vary by
# inverter model.  If the values look wrong, adjust the "index" values in
# SMART_METER_FIELDS inside exporter.py.
ENABLE_SMART_METER=false
